{
  "name": "personal-encyclopedia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Wikipedia-inspired personal encyclopedia for mathematics, photographs, and remembered days.",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:pages": "node tools/build.mjs && node tools/stage.mjs",
    "deploy": "npm run build:pages && wrangler deploy",
    "stage": "node tools/stage.mjs",
    "new": "node tools/new-post.mjs",
    "start": "node tools/build.mjs && node tools/serve.mjs",
    "dev": "node tools/dev.mjs",
    "serve": "node tools/serve.mjs",
    "dashboard": "node dashboard/server.mjs"
  },
  "dependencies": {
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
